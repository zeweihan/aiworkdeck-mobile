/* AI Workdeck Mobile — 设计令牌
 *
 * 双模：拍摄与影像浏览走深色（器械感 + 真玻璃），其余走浅色（与桌面端同调）。
 * iOS 端有一份逐值对应的 Swift 版本，改这里必须同步那边。
 *
 * 浅色侧的关键决定：底是纯白，不是浅灰。
 * 浅灰底 + 白卡片 + 阴影 = 后台仪表盘语汇。分区靠发丝线与留白，不靠盒子。
 */

page {
  /* ---- 浅色（项目、文件、设置） ------------------------------------- */
  --bg: #FFFFFF;
  --bg-sunken: #FAFAFA;          /* 极少用，仅用于需要退后的整块区域 */
  --fg: #0A0E1A;                 /* 近黑，不是纯黑 */
  --fg-muted: #6B7280;
  --fg-faint: #9CA3AF;
  --rule: #ECEEF1;               /* 发丝线，比常见的 #E5E7EB 再淡一档 */
  --rule-strong: #D4D8DE;

  /* 藏青只作强调，且用量极小。用多了就回到"企业蓝"的俗气里。 */
  --accent: #1E3A8A;
  --accent-wash: #F4F6FB;

  /* ---- 深色（取景、影像浏览） ---------------------------------------- */
  --dk-bg: #0A0B0D;
  --dk-surface: #141619;
  --dk-fg: #F5F6F7;
  --dk-fg-muted: #8A8F98;
  --dk-rule: rgba(255, 255, 255, 0.10);

  /* ---- 状态：只做小色点与小字，绝不做大块彩色数字 --------------------- */
  --st-waiting: #C2410C;         /* 在手机上 */
  --st-moving: #1E3A8A;          /* 在路上 */
  --st-arrived: #15803D;         /* 已归档 */
  --st-failed: #B91C1C;

  /* ---- 间距 ----------------------------------------------------------- */
  --s1: 8rpx;
  --s2: 16rpx;
  --s3: 24rpx;
  --s4: 32rpx;
  --s5: 40rpx;
  --s6: 48rpx;
  --s8: 64rpx;
  --s10: 80rpx;
  --s16: 128rpx;

  /* 页面左右边距。32rpx = 16pt，与 iOS 系统列表一致。 */
  --gutter: 40rpx;

  /* ---- 字号 ------------------------------------------------------------
   * 用 px 不用 rpx：rpx 会随屏宽缩放，小屏上正文掉到 14px 以下。
   * 层级靠字级跨度拉开，不靠颜色。
   */
  --t-hero: 44px;      /* 只给关键数字 */
  --t-display: 30px;
  --t-title: 21px;
  --t-heading: 16px;
  --t-body: 15px;
  --t-small: 13px;
  --t-micro: 11px;
  --t-nano: 10px;      /* 全大写字距拉开的标签 */

  --font-sans: system-ui, -apple-system, "PingFang SC", "HarmonyOS Sans SC",
               "Source Han Sans SC", "Helvetica Neue", sans-serif;
  /* 哈希、时间、坐标、计数一律等宽——取证信息要能逐字符核对 */
  --font-mono: "SF Mono", ui-monospace, Menlo, Consolas, monospace;

  /* ---- 动效 ------------------------------------------------------------ */
  --d-fast: 140ms;
  --d-base: 220ms;
  --d-slow: 320ms;
  --e-out: cubic-bezier(0.22, 1, 0.36, 1);
  --e-in: cubic-bezier(0.55, 0, 1, 0.45);

  --touch-min: 88rpx;
}

/* 全大写小标签。字距拉开是这套排版的签名，别改。 */
.label {
  font-size: var(--t-nano);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--fg-faint);
  font-weight: 500;
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.rule {
  height: 1rpx;
  background: var(--rule);
}
