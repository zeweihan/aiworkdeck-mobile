/* 毛玻璃 —— 只用于浮层，绝不用于内容区。
 *
 * 内容区不用玻璃的理由很实际：玻璃吃对比度，而现场光线本来就差。
 * 规则库对 Glassmorphism 的标注就是「须确保 4.5:1」——在别人办公室里
 * 单手举着手机的场景下，这个余量不能省。
 *
 * 用法：<view class="glass {{glassMode === 'solid' ? 'glass--solid' : ''}}">
 * glassMode 由 utils/capability.ts 给出。
 */

.glass {
  position: relative;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: var(--elev-2);
}

/* 顶边高光：玻璃的立体感主要来自这条，不是来自模糊本身 */
.glass::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.9) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
}

/* 降级：安卓中低端机 / 不支持 backdrop-filter。
 * 保留分层感与顶边高光，只是不透背景。视觉上仍然成立，不会显得是残次品。 */
.glass--solid {
  background: rgba(252, 253, 255, 0.98);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 1rpx solid var(--color-border);
}

/* 深色浮层（拍摄页控制条压在取景画面上） */
.glass-dark {
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(24px) saturate(140%);
  -webkit-backdrop-filter: blur(24px) saturate(140%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.glass-dark.glass--solid {
  background: rgba(15, 23, 42, 0.88);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* ---- 浮现 ---------------------------------------------------------------
 * opacity + 12px 位移 + scale 0.96→1，进入 220ms，退出比进入快。
 * 列表用 stagger，每项 50ms。
 */
@keyframes awd-rise {
  from {
    opacity: 0;
    transform: translate3d(0, 24rpx, 0) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

.rise {
  animation: awd-rise var(--dur-base) var(--ease-out) both;
}

.rise-1 { animation-delay: 50ms; }
.rise-2 { animation-delay: 100ms; }
.rise-3 { animation-delay: 150ms; }
.rise-4 { animation-delay: 200ms; }
.rise-5 { animation-delay: 250ms; }
