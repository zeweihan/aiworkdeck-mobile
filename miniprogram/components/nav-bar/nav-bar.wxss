.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(248, 250, 252, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid transparent;
  transition: border-color var(--d-base) var(--e-out),
              background-color var(--d-base) var(--e-out);
}

.nav.glass--solid {
  background: #FBFCFE;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* 滚动后才出分隔线。静止时导航与内容是连续的一张纸。 */
.nav--scrolled {
  border-bottom-color: var(--rule);
}

.nav__content {
  display: flex;
  align-items: center;
  padding-left: var(--s3);
  gap: var(--s2);
}

.nav__back {
  width: var(--touch-min);
  height: var(--touch-min);
  margin-left: calc(var(--s3) * -1);
  flex-shrink: 0;
}

/* 返回箭头用 CSS 画，省一个图片请求 */
.nav__back-glyph {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--fg);
  border-bottom: 3rpx solid var(--fg);
  transform: rotate(45deg);
  border-radius: 1rpx;
}

.nav__titles {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nav__title {
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--fg);
  line-height: 1.2;
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__subtitle {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  line-height: 1.3;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 深色变体（图集等影像浏览页，D7） ------------------------------------ */
.nav--dark {
  background: rgba(10, 11, 13, 0.72);
}

.nav--dark.glass--solid {
  background: var(--dk-surface);
}

.nav--dark.nav--scrolled {
  border-bottom-color: var(--dk-rule);
}

.nav--dark .nav__back-glyph {
  border-color: var(--dk-fg);
}

.nav--dark .nav__title {
  color: var(--dk-fg);
}

.nav--dark .nav__subtitle {
  color: var(--dk-fg-muted);
}
