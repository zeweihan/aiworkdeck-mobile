/* 上传队列页。视觉语汇与 index/login/project 一致：纯白底、发丝线分区
 * （.rule 来自 tokens.wxss）、无卡片阴影；状态色只做小圆点，不染大块文字。 */

.page {
  padding: 0 var(--gutter);
  background: var(--bg);
}

/* ---- 空态：与 project 页三态共用的居中布局同一口径 ------------------------ */
.status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s16) var(--s4) 0;
  text-align: center;
}

.status__text {
  font-size: var(--t-small);
  color: var(--fg-muted);
  line-height: 1.6;
}

/* ---- 列表 ------------------------------------------------------------------ */
.list { padding-top: var(--s3); }

.item__row {
  display: flex;
  align-items: flex-start;
  gap: var(--s3);
  padding: var(--s3) 0;
}

/* 缩略图：真实图片（照片原图 / 录像帧图），无图回落色块底 + 图标 */
.item__thumb {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--s1);
  overflow: hidden;
  background: var(--bg-sunken);
  flex-shrink: 0;
}

.item__thumb-img {
  width: 100%;
  height: 100%;
}

.item__thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item__thumb-ph--doc   { background: linear-gradient(150deg, #E8EDF5 0%, #D4DDEA 100%); }
.item__thumb-ph--scene { background: linear-gradient(150deg, #E3E9E4 0%, #CFD9D2 100%); }
.item__thumb-ph--audio { background: linear-gradient(150deg, #EEE9F2 0%, #DCD4E3 100%); }

.item__thumb-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}

/* 状态点压在缩略图右上角——扫一眼就知道哪些还没走 */
.item__dot {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.dot--waiting { background: var(--st-waiting); }
.dot--moving  { background: var(--st-moving); }
.dot--arrived { background: var(--st-arrived); }
.dot--failed  { background: var(--st-failed); }

.item__body { flex: 1; min-width: 0; }

.item__name {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--fg);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__meta {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  margin-top: 2rpx;
}

.item__status {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  margin-top: var(--s1);
}

/* 桌面离线不隐瞒：等待久了要说清楚等了多久 */
.item__waiting {
  font-size: var(--t-micro);
  color: var(--st-waiting);
  margin-top: 2rpx;
}

/* 失败原因原文（如「云端空间已满」）：红色小字，用户要看得见才知道怎么办 */
.item__error {
  font-size: var(--t-micro);
  color: var(--st-failed);
  margin-top: 2rpx;
  line-height: 1.5;
}

/* 快到期催收：暖色小字，与等待提示同一档 */
.item__expires {
  font-size: var(--t-micro);
  color: var(--st-waiting);
  margin-top: 2rpx;
  line-height: 1.5;
}

.item__retry {
  flex-shrink: 0;
  padding: 0 var(--s3);
  min-height: var(--touch-min);
  font-size: var(--t-small);
  font-weight: 500;
  color: var(--accent);
}

/* ---- 分区（失败 / 上传中 / 已暂存 / 已落盘） ------------------------------ */
.section { padding-top: var(--s5); }

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--s1);
}

.section__count {
  font-size: var(--t-micro);
  color: var(--fg-faint);
}

/* 队列只看当前项目，别的项目的未落盘件至少提一句 */
.other {
  padding: var(--s6) 0 var(--s4);
}

.other__text {
  font-size: var(--t-micro);
  color: var(--fg-faint);
  line-height: 1.5;
}
