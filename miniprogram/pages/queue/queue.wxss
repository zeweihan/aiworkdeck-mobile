.page { padding: var(--s6) var(--s4); }
.empty { display: flex; flex-direction: column; gap: var(--s2); align-items: center; padding-top: var(--s10); }
.empty__title { font-size: var(--t-heading); font-weight: 600; color: var(--fg); }
.empty__text { font-size: var(--t-small); color: var(--fg-muted); text-align: center; line-height: 1.6; }
