/* 上传队列页。视觉语汇与 index/login/project 一致：纯白底、发丝线分区
 * （.rule 来自 tokens.wxss）、无卡片阴影；状态色只做小圆点，不染大块文字。 */

.page {
  padding: 0 var(--gutter);
  background: var(--bg);
}

/* ---- 空态：与 project 页三态共用的居中布局同一口径 ------------------------ */
.status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s16) var(--s4) 0;
  text-align: center;
}

.status__text {
  font-size: var(--t-small);
  color: var(--fg-muted);
  line-height: 1.6;
}

/* ---- 列表 ------------------------------------------------------------------ */
.list { padding-top: var(--s3); }

.item__row {
  display: flex;
  align-items: flex-start;
  gap: var(--s3);
  padding: var(--s3) 0;
}

.item__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.dot--waiting { background: var(--st-waiting); }
.dot--moving  { background: var(--st-moving); }
.dot--arrived { background: var(--st-arrived); }
.dot--failed  { background: var(--st-failed); }

.item__body { flex: 1; min-width: 0; }

.item__name {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--fg);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__meta {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  margin-top: 2rpx;
}

.item__status {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  margin-top: var(--s1);
}

/* 桌面离线不隐瞒：等待久了要说清楚等了多久 */
.item__waiting {
  font-size: var(--t-micro);
  color: var(--st-waiting);
  margin-top: 2rpx;
}

/* 失败原因原文（如「云端空间已满」）：红色小字，用户要看得见才知道怎么办 */
.item__error {
  font-size: var(--t-micro);
  color: var(--st-failed);
  margin-top: 2rpx;
  line-height: 1.5;
}

/* 快到期催收：暖色小字，与等待提示同一档 */
.item__expires {
  font-size: var(--t-micro);
  color: var(--st-waiting);
  margin-top: 2rpx;
  line-height: 1.5;
}

.item__retry {
  flex-shrink: 0;
  padding: 0 var(--s3);
  min-height: var(--touch-min);
  font-size: var(--t-small);
  font-weight: 500;
  color: var(--accent);
}
