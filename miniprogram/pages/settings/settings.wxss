/* 「我的」页。视觉语汇照抄项目页 / 登录页：纯白底、发丝线分区（.rule 来自 tokens.wxss）、
 * 无卡片阴影。每一行都是「小标签 + 右侧值」，值右对齐，行与行之间只用发丝线分开。 */

.page {
  display: flex;
  flex-direction: column;
  /* min-height 由页面按导航栏高度算，见 settings.wxml */
  padding: 0 var(--gutter);
  background: var(--bg);
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--s3);
  min-height: var(--touch-min);
  padding: var(--s3) var(--s1);
}

.row__label {
  flex-shrink: 0;
  font-size: var(--t-micro);
  letter-spacing: 0.08em;
  color: var(--fg-faint);
}

.row__right {
  display: flex;
  align-items: baseline;
  gap: var(--s3);
}

.row__value {
  font-size: var(--t-body);
  color: var(--fg);
  font-variant-numeric: tabular-nums;
  text-align: right;
}

/* 充值入口：文字按钮，不做实心块。尺寸不覆盖 .tappable 的 88rpx 最小可点区。 */
.row__action {
  font-size: var(--t-small);
  color: var(--accent);
}

/* NOT_CONNECTED 时那句「充值后即开通统一账户」：跟在余额行下面，不抢行内空间 */
.hint {
  display: block;
  padding: 0 var(--s1) var(--s3);
  font-size: var(--t-micro);
  color: var(--fg-muted);
  line-height: 1.6;
}

.footer {
  margin-top: auto;
  padding: var(--s10) 0 var(--s6);
  text-align: center;
}

.footer__text {
  display: inline-flex;
  font-size: var(--t-small);
  color: var(--fg-faint);
}
