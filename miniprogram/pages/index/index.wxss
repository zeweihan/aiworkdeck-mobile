.page {
  padding: var(--s3) var(--s4) 0;
}

/* ---- 桌面端连接状态 ------------------------------------------------------ */
.link {
  display: flex;
  align-items: center;
  gap: var(--s3);
  padding: var(--s3);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid var(--rule);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.link.glass--solid {
  background: var(--bg);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.link--offline { background: var(--bg); }

.link__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.link__text { flex: 1; min-width: 0; }

.link__title {
  font-size: var(--t-small);
  font-weight: 600;
  color: var(--fg);
  line-height: 1.3;
}

.link__meta {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  line-height: 1.4;
  margin-top: 2rpx;
}

/* 在线呼吸点。唯一一处循环动画——它表示「连接是活的」，承载语义。 */
.link__pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--fg-faint);
  flex-shrink: 0;
}

.link__pulse--on {
  background: var(--st-arrived);
  animation: awd-breathe 2.4s var(--e-out) infinite;
}

@keyframes awd-breathe {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(21, 128, 61, 0.4); }
  50%      { opacity: 0.75; box-shadow: 0 0 0 8rpx rgba(21, 128, 61, 0); }
}

/* ---- 状态三联 ------------------------------------------------------------ */
.states {
  display: flex;
  align-items: stretch;
  margin-top: var(--s3);
  padding: var(--s4) var(--s2);
  background: var(--bg);
  border-radius: 16rpx;
  border: 1rpx solid var(--rule);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-height: var(--touch-min);
  justify-content: center;
}

.state:active { opacity: 0.6; }

.state__div {
  width: 1rpx;
  background: var(--rule);
  margin: var(--s1) 0;
}

.state__num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: var(--t-display);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.state__num--waiting { color: var(--st-waiting); }
.state__num--moving  { color: var(--st-moving); }
.state__num--arrived { color: var(--st-arrived); }

.state__label {
  font-size: var(--t-small);
  font-weight: 500;
  color: var(--fg);
  margin-top: var(--s1);
}

.state__hint {
  font-size: var(--t-micro);
  color: var(--fg-faint);
}

/* ---- 主行动 -------------------------------------------------------------- */
.capture {
  flex-direction: column;
  gap: var(--s1);
  margin-top: var(--s3);
  padding: var(--s6) var(--s4);
  border-radius: 24rpx;
  background: linear-gradient(160deg, var(--accent) 0%, #172554 100%);
  box-shadow: 0 12rpx 32rpx rgba(30, 58, 138, 0.24);
}

.capture__icon { width: 56rpx; height: 56rpx; }

.capture__label {
  font-size: var(--t-title);
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.02em;
  margin-top: var(--s1);
}

.capture__sub {
  font-size: var(--t-micro);
  color: rgba(255, 255, 255, 0.72);
}

/* ---- 取证说明 ------------------------------------------------------------ */
.assure {
  display: flex;
  align-items: center;
  gap: var(--s2);
  margin-top: var(--s3);
  padding: var(--s2) var(--s3);
  background: var(--accent-wash);
  border-radius: 8rpx;
}

.assure__icon { width: 30rpx; height: 30rpx; flex-shrink: 0; }

.assure__text {
  font-size: var(--t-micro);
  color: var(--accent);
  line-height: 1.5;
}

/* ---- 最近影像 ------------------------------------------------------------ */
.section { margin-top: var(--s6); }

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s3);
}

.section__title {
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.01em;
}

.section__more {
  flex-direction: row;
  gap: 2rpx;
  justify-content: flex-end;
  min-width: auto;
  padding-left: var(--s3);
}

.section__more-text { font-size: var(--t-small); color: var(--fg-muted); }
.section__more-icon { width: 26rpx; height: 26rpx; }

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s2);
}

.tile {
  position: relative;
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--bg-sunken);
  animation: awd-rise var(--d-base) var(--e-out) both;
}

/* 占位缩略图。接后端后换成真实图片，保留同样的圆角与比例。 */
.tile__thumb { width: 100%; height: 100%; }
.tile__thumb--doc   { background: linear-gradient(150deg, #E8EDF5 0%, #D4DDEA 100%); }
.tile__thumb--scene { background: linear-gradient(150deg, #E3E9E4 0%, #CFD9D2 100%); }

/* 状态点压在缩略图上——扫一眼就知道哪些还没走 */
.tile__badge {
  position: absolute;
  top: var(--s1);
  right: var(--s1);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.tile__badge--waiting { background: var(--st-waiting); }
.tile__badge--moving  { background: var(--st-moving); }
.tile__badge--arrived { background: var(--st-arrived); }

.tile__time {
  position: absolute;
  left: var(--s1);
  bottom: var(--s1);
  font-size: var(--t-micro);
  color: var(--fg-muted);
  background: rgba(255, 255, 255, 0.82);
  padding: 0 6rpx;
  border-radius: 4rpx;
}
