/* 主界面。视觉语汇与 login/project 一致：纯白底、发丝线分区（.rule 来自
 * tokens.wxss）、字级跨度做层级、无卡片阴影；状态色只做小圆点，不染大数字。 */

.page {
  padding: 0 var(--gutter);
  background: var(--bg);
}

/* ---- 当前设备 + 切换项目 -------------------------------------------------- */
.device {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s4) 0;
}

.device__text { display: flex; flex-direction: column; gap: 2rpx; }

.device__name {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--fg);
}

.device__hint {
  font-size: var(--t-micro);
  color: var(--fg-faint);
}

.device__switch {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
}

.device__switch-text {
  font-size: var(--t-small);
  color: var(--accent);
  font-weight: 500;
}

.device__chevron { width: 28rpx; height: 28rpx; }

/* ---- 状态三联 -------------------------------------------------------------- */
.stats {
  display: flex;
  padding: var(--s4) 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s1);
  min-height: var(--touch-min);
  justify-content: center;
}

.stat__row {
  display: flex;
  align-items: center;
  gap: var(--s1);
}

.stat__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.stat__dot--waiting { background: var(--st-waiting); }
.stat__dot--moving  { background: var(--st-moving); }
.stat__dot--arrived { background: var(--st-arrived); }

.stat__num {
  font-size: var(--t-display);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.02em;
}

.stat__label {
  font-size: var(--t-small);
  color: var(--fg-muted);
}

/* ---- 主行动：全 App 唯一强调色实心按钮，仍不加阴影 ------------------------- */
.capture {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--s5) 0 var(--s3);
  padding: var(--s5) var(--s4);
  border-radius: var(--s3);
  background: var(--accent);
}

.capture__title {
  font-size: var(--t-title);
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.01em;
}

.capture__sub {
  margin-top: 4rpx;
  font-size: var(--t-micro);
  color: rgba(255, 255, 255, 0.72);
}

.capture__icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }

/* 录制中拍摄按钮禁用：只降透明度，不换色相 */
.capture--disabled { opacity: 0.4; }

/* ---- 录音：拍摄的姊妹行动，浅底描边不与唯一强调色实心按钮争强调 ------------ */
.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 var(--s3);
  padding: var(--s4);
  border-radius: var(--s3);
  background: var(--accent-wash);
  border: 1rpx solid var(--rule-strong);
}

.record__title {
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--accent);
}

.record__sub {
  margin-top: 4rpx;
  font-size: var(--t-micro);
  color: var(--fg-muted);
}

.record__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }

/* 录制中 */
.record--active { border-color: var(--accent); }

.record__status {
  display: flex;
  align-items: center;
  gap: var(--s2);
}

.record__pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--st-failed);
  animation: record-pulse 1.2s ease-in-out infinite;
}

@keyframes record-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.record__timer {
  font-size: var(--t-title);
  font-weight: 600;
  color: var(--fg);
}

.record__segment {
  font-size: var(--t-small);
  color: var(--fg-muted);
}

.record__stop {
  flex-shrink: 0;
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  padding: 0 var(--s4);
  border-radius: var(--s2);
  background: var(--accent);
  font-size: var(--t-body);
  font-weight: 600;
  color: #FFFFFF;
}

/* ---- 能力边界说明（D6，不能默默降级） ------------------------------------- */
.note { padding: 0 0 var(--s4); }

.note__text {
  font-size: var(--t-micro);
  color: var(--fg-faint);
  line-height: 1.6;
}

/* ---- 最近影像 -------------------------------------------------------------- */
.section { padding: var(--s4) 0 var(--s6); }

.section .label { display: block; margin-bottom: var(--s3); }

.section__empty {
  padding: var(--s6) 0;
  text-align: center;
  font-size: var(--t-small);
  color: var(--fg-faint);
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s2);
}

.tile {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--s1);
  overflow: hidden;
  background: var(--bg-sunken);
}

/* 占位缩略图。接后端后换成真实图片，保留同样的圆角与比例。 */
.tile__thumb { width: 100%; height: 100%; }
.tile__thumb--doc   { background: linear-gradient(150deg, #E8EDF5 0%, #D4DDEA 100%); }
.tile__thumb--scene { background: linear-gradient(150deg, #E3E9E4 0%, #CFD9D2 100%); }
.tile__thumb--audio { background: linear-gradient(150deg, #EEE9F2 0%, #DCD4E3 100%); }

/* 状态点压在缩略图上——扫一眼就知道哪些还没走 */
.tile__dot {
  position: absolute;
  top: var(--s1);
  right: var(--s1);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.tile__dot--waiting { background: var(--st-waiting); }
.tile__dot--moving  { background: var(--st-moving); }
.tile__dot--arrived { background: var(--st-arrived); }

.tile__time {
  position: absolute;
  left: var(--s1);
  bottom: var(--s1);
  font-size: var(--t-micro);
  color: var(--fg-muted);
  background: rgba(255, 255, 255, 0.82);
  padding: 0 6rpx;
  border-radius: 4rpx;
}
