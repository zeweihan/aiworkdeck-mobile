<nav-bar
  title="{{project.name}}"
  subtitle="归档至 {{project.archivePath}}"
  scroll-top="{{scrollTop}}"
  bind:titletap="onSwitchProject"
/>

<view class="page" style="padding-bottom: {{metrics.bottomInset}}px;">

  <!-- 当前设备 + 切换项目，替掉原来的桌面在线演示行 -->
  <view class="device tappable" bindtap="onSwitchProject">
    <view class="device__text">
      <text class="device__name">{{deviceName}}</text>
      <text class="device__hint">桌面端设备</text>
    </view>
    <view class="device__switch">
      <text class="device__switch-text">切换项目</text>
      <image class="device__chevron" src="{{Icon.chevron}}" mode="aspectFit" />
    </view>
  </view>
  <view class="rule"></view>

  <!-- 状态三联：色只做小圆点，数字本身不着色 -->
  <view class="stats">
    <view class="stat tappable" bindtap="onOpenQueue">
      <view class="stat__row">
        <view class="stat__dot stat__dot--waiting"></view>
        <view class="stat__num mono">{{counts.waiting}}</view>
      </view>
      <view class="stat__label">等待中</view>
    </view>
    <view class="stat tappable" bindtap="onOpenQueue">
      <view class="stat__row">
        <view class="stat__dot stat__dot--moving"></view>
        <view class="stat__num mono">{{counts.moving}}</view>
      </view>
      <view class="stat__label">上传中</view>
    </view>
    <view class="stat tappable" bindtap="onOpenQueue">
      <view class="stat__row">
        <view class="stat__dot stat__dot--arrived"></view>
        <view class="stat__num mono">{{counts.arrived}}</view>
      </view>
      <view class="stat__label">已抵达</view>
    </view>
  </view>
  <view class="rule"></view>

  <!-- 主行动。现场是单手操作、光线差、可能还有点紧张，所以按钮要大、要稳、只有一个。 -->
  <view
    class="capture tappable {{recording ? 'capture--disabled' : ''}}"
    bindtap="onCapture"
    aria-label="开始拍摄"
  >
    <view class="capture__text">
      <view class="capture__title">开始拍摄</view>
      <view class="capture__sub">拍摄内容自动归入今天的现场影像</view>
    </view>
    <image class="capture__icon" src="{{Icon.cameraWhite}}" mode="aspectFit" />
  </view>

  <!-- 录音入口：拍摄的姊妹行动，浅底描边不与主按钮争强调；
       录制中换成 计时 + 段号 + 停止，续段全静默不打断 -->
  <view class="record tappable" wx:if="{{!recording}}" bindtap="onStartRecord" aria-label="开始录音">
    <view class="record__text">
      <view class="record__title">开始录音</view>
      <view class="record__sub">录音自动归入今天的现场录音，单段满 10 分钟自动续录</view>
    </view>
    <image class="record__icon" src="{{Icon.micNavy}}" mode="aspectFit" />
  </view>
  <view class="record record--active" wx:else>
    <view class="record__text">
      <view class="record__status">
        <view class="record__pulse"></view>
        <text class="record__timer mono">{{recordElapsed}}</text>
        <text class="record__segment">第 {{recordSegment}} 段</text>
      </view>
      <view class="record__sub">录音中，每段录满自动续录下一段</view>
    </view>
    <view class="record__stop tappable" bindtap="onStopRecord" aria-label="停止录音">
      <text>停止</text>
    </view>
  </view>

  <!-- D6：能力边界要明示，不能默默降级 -->
  <view class="note">
    <text class="note__text">录像单段最长 60 秒，长内容自动分段归档；本端录像为记录用途，证据用途请用 iOS 端。</text>
  </view>
  <view class="rule"></view>

  <view class="section">
    <text class="label">最近影像</text>

    <view class="grid" wx:if="{{recent.length}}">
      <view wx:for="{{recent}}" wx:key="id" class="tile">
        <view class="tile__thumb tile__thumb--{{item.kind}}"></view>
        <view class="tile__dot tile__dot--{{item.state}}"></view>
        <view class="tile__time mono">{{item.time}}</view>
      </view>
    </view>
    <view class="section__empty" wx:else>还没有拍摄记录</view>
  </view>
</view>
