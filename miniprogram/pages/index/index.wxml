<!-- 取景器优先的拍摄主界面（D7 深色）。
     顶部信息 / 中部取景 + 左下角淡水印 / 底部三档模式 + 大快门 + 最近缩略图入口。
     导航高度只用全局度量（metrics），页面不自己测量。 -->
<view class="cap" style="padding-bottom: {{metrics.bottomInset}}px;">

  <!-- 顶部信息层 -->
  <view class="top" style="padding-top: {{metrics.navTotalHeight}}px;">
    <view class="top__project tappable" bindtap="onSwitchProject">
      <view class="top__name-row">
        <text class="top__name">{{project.name}}</text>
        <image class="top__chevron" src="{{Icon.chevronWhite}}" mode="aspectFit" />
      </view>
      <text class="top__path">归档至 {{project.archivePath}}</text>
    </view>
    <view class="top__stats tappable" bindtap="onOpenQueue">
      <view class="top__stat">
        <view class="top__dot top__dot--waiting"></view>
        <text class="top__num mono">{{tally.uploading}}</text>
        <text class="top__label">上传中</text>
        <!-- 失败不单独成桶，但不能藏：云端满、会话过期这类不重试也不会好 -->
        <text wx:if="{{tally.failed > 0}}" class="top__failed">含 {{tally.failed}} 失败</text>
      </view>
      <view class="top__stat">
        <view class="top__dot top__dot--moving"></view>
        <text class="top__num mono">{{tally.staged}}</text>
        <text class="top__label">已暂存</text>
      </view>
      <view class="top__stat">
        <view class="top__dot top__dot--arrived"></view>
        <text class="top__num mono">{{tally.landed}}</text>
        <text class="top__label">已落盘</text>
      </view>
    </view>
  </view>

  <!-- 取景区 -->
  <view class="finder">
    <camera
      wx:if="{{mode !== 'audio' && cameraState !== 'denied'}}"
      class="finder__camera"
      device-position="back"
      flash="off"
      binderror="onCameraError"
      bindinitdone="onCameraReady"
    />

    <!-- 相机权限被拒 / 初始化失败的降级态：明示 + 去设置 + 系统相机兜底 -->
    <view wx:if="{{mode !== 'audio' && cameraState === 'denied'}}" class="finder__denied">
      <text class="finder__denied-title">相机权限未开启</text>
      <text class="finder__denied-sub">取景拍摄需要使用相机。请在设置里打开「摄像头」权限后回到本页。</text>
      <view class="finder__denied-btn tappable" bindtap="onOpenCameraSetting">
        <text>去设置</text>
      </view>
      <view class="finder__denied-alt tappable" bindtap="onSystemCapture">
        <text>改用系统相机拍摄</text>
      </view>
    </view>

    <!-- 录音档：无取景画面，深色面板 + 麦克风 -->
    <view wx:if="{{mode === 'audio'}}" class="finder__audio">
      <image class="finder__audio-icon {{recording ? 'finder__audio-icon--live' : ''}}" src="{{Icon.micWhite}}" mode="aspectFit" />
      <text class="finder__audio-hint">{{recording ? '录音中，每段录满 10 分钟自动续录下一段' : '按下方按钮开始录音'}}</text>
    </view>

    <!-- 左下角淡水印：仅界面叠加，不写入影像（保护取证哈希链的刻意决策） -->
    <view wx:if="{{mode !== 'audio' && cameraState === 'ready'}}" class="wm">
      <text class="wm__line mono">{{wmTime}}</text>
      <text class="wm__line wm__line--name">{{project.name}}</text>
    </view>

    <!-- 录制中状态条（录像/录音共用） -->
    <view wx:if="{{recording}}" class="rec">
      <view class="rec__pulse"></view>
      <text class="rec__timer mono">{{recordElapsed}}</text>
      <text class="rec__segment">第 {{recordSegment}} 段</text>
    </view>
  </view>

  <!-- D6：能力边界明示，随模式切换 -->
  <view class="note">
    <text class="note__text">{{modeNote}}</text>
  </view>

  <!-- 底部控制区 -->
  <view class="ctrl">
    <view class="ctrl__modes">
      <view
        class="ctrl__mode tappable {{mode === 'photo' ? 'ctrl__mode--on' : ''}}"
        data-mode="photo"
        bindtap="onSwitchMode"
      ><text>照片</text></view>
      <view
        class="ctrl__mode tappable {{mode === 'video' ? 'ctrl__mode--on' : ''}}"
        data-mode="video"
        bindtap="onSwitchMode"
      ><text>录像</text></view>
      <view
        class="ctrl__mode tappable {{mode === 'audio' ? 'ctrl__mode--on' : ''}}"
        data-mode="audio"
        bindtap="onSwitchMode"
      ><text>录音</text></view>
    </view>

    <view class="ctrl__row">
      <!-- 最近一件缩略图入口：真图（照片原图 / 录像帧图），audio 用色块底 + 麦克风 -->
      <view class="ctrl__recent tappable" bindtap="onOpenGallery" aria-label="查看图集">
        <block wx:if="{{recent}}">
          <image
            wx:if="{{recent.thumb}}"
            class="ctrl__recent-img"
            src="{{recent.thumb}}"
            mode="aspectFill"
            binderror="onRecentThumbError"
          />
          <view wx:else class="ctrl__recent-ph">
            <image class="ctrl__recent-icon" src="{{recent.icon}}" mode="aspectFit" />
          </view>
          <view class="ctrl__recent-dot {{recent.dotClass}}"></view>
        </block>
        <view wx:else class="ctrl__recent-empty"></view>
      </view>

      <!-- 大快门：照片白芯；录像/录音红芯，录制中变红方块 -->
      <view
        class="shutter tappable"
        bindtap="onShutter"
        aria-label="{{mode === 'photo' ? '拍照' : (recording ? '停止录制' : '开始录制')}}"
      >
        <view class="shutter__core {{mode === 'photo' ? 'shutter__core--photo' : (recording ? 'shutter__core--stop' : 'shutter__core--rec')}}"></view>
      </view>

      <!-- 存相册开关（对齐 iOS 设置页「同时存入系统相册」，默认关，知情选择） -->
      <view
        class="ctrl__album tappable {{saveToAlbum ? 'ctrl__album--on' : ''}}"
        bindtap="onToggleAlbum"
        aria-label="拍摄件同时存入系统相册，当前{{saveToAlbum ? '开启' : '关闭'}}"
      >
        <text class="ctrl__album-text">存相册</text>
        <text class="ctrl__album-state">{{saveToAlbum ? '开' : '关'}}</text>
      </view>
    </view>
  </view>
</view>
