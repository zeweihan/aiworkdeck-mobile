.root {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* ---- 顶部：信息不消失，只是不喊 -------------------------------------- */
.top { padding: var(--s6) var(--gutter) 0; }

.top__name {
  font-size: var(--t-title);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.01em;
  margin-top: var(--s2);
}

.top__line {
  margin-top: var(--s3);
  font-size: var(--t-small);
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.n { font-weight: 500; }
.n--w { color: var(--st-waiting); }
.n--m { color: var(--st-moving); }
.n--a { color: var(--st-arrived); }

.u { font-size: var(--t-nano); color: var(--fg-faint); margin-left: 2rpx; }
.d { color: var(--rule-strong); margin: 0 var(--s2); font-size: var(--t-micro); }

/* ---- 主控件 ---------------------------------------------------------
 * 留白是设计的一部分。flex:1 让转盘永远待在视觉中心。 */
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--s10) 0;
}

.dial {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 外环：细、准、不发光。这条线的粗细决定了整个界面的精度感。 */
.dial__ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid var(--rule-strong);
}

/* 四个刻度：仪器的签名细节 */
.dial__tick {
  position: absolute;
  inset: 0;
}
.dial__tick::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: 50%;
  width: 2rpx;
  height: 16rpx;
  margin-left: -1rpx;
  background: var(--rule-strong);
}

.dial__core {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: var(--fg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--d-base) var(--e-out);
}

/* 中心镜头环：一个同心圆，暗示"这是个光学器件" */
.dial__lens {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
}

.dial--down .dial__core { transform: scale(0.94); }

.stage__cap {
  margin-top: var(--s6);
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: 0.24em;      /* 字距是这套设计的签名 */
  text-indent: 0.24em;
}

.stage__sub {
  margin-top: var(--s1);
  font-size: var(--t-micro);
  color: var(--fg-faint);
}

/* ---- 底部 ------------------------------------------------------------ */
.bottom { padding-bottom: var(--s8); }

.strip {
  display: flex;
  gap: var(--s1);
  padding: 0 var(--gutter) var(--s5);
}

.sq {
  position: relative;
  flex: 1;
  aspect-ratio: 1;
  border-radius: 2rpx;
  overflow: hidden;
}

.sq__i { width: 100%; height: 100%; }
.sq__i--doc   { background: #EDEFF2; }
.sq__i--scene { background: #E7EAE8; }

.sq__d {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.sq__d--waiting { background: var(--st-waiting); }
.sq__d--moving  { background: var(--st-moving); }
.sq__d--arrived { background: var(--st-arrived); }

.sq--more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-sunken);
  border: 1rpx solid var(--rule);
}

.sq__more { font-size: var(--t-nano); color: var(--fg-muted); }

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s3) var(--gutter) 0;
}

.foot__l { display: flex; align-items: center; gap: var(--s1); }

.foot__pulse {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--st-arrived);
}

.foot__t { font-size: var(--t-nano); color: var(--fg-muted); letter-spacing: 0.04em; }
.foot__t--faint { color: var(--fg-faint); }
