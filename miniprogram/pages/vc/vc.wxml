<!-- 方向 C：仪器极简 —— 一台只有一个按钮的器械。
     Braun / Dieter Rams 的语汇：一个主控件，其余全部退到极小。
     信息不消失，只是不喊。 -->
<view class="root" style="padding-top: {{m.navTotalHeight}}px;">

  <view class="top">
    <view class="label">当前项目</view>
    <view class="top__name">{{project.name}}</view>
    <view class="top__line mono">
      <text class="n n--w">12</text><text class="u">待传</text>
      <text class="d">/</text>
      <text class="n n--m">3</text><text class="u">传输中</text>
      <text class="d">/</text>
      <text class="n n--a">148</text><text class="u">已归档</text>
    </view>
  </view>

  <!-- 主控件。留白是它的一部分，不要压缩。 -->
  <view class="stage">
    <view class="dial" bindtap="onCapture" hover-class="dial--down" hover-stay-time="60">
      <view class="dial__ring"></view>
      <view class="dial__tick" wx:for="{{[0,1,2,3]}}" wx:key="*this" style="transform: rotate({{item * 90}}deg)"></view>
      <view class="dial__core">
        <view class="dial__lens"></view>
      </view>
    </view>
    <view class="stage__cap">拍摄</view>
    <view class="stage__sub">归档至 {{project.archive}}</view>
  </view>

  <view class="bottom">
    <view class="strip">
      <view class="sq" wx:for="{{recent}}" wx:key="id" wx:if="{{index < 5}}">
        <view class="sq__i sq__i--{{item.kind}}"></view>
        <view class="sq__d sq__d--{{item.state}}"></view>
      </view>
      <view class="sq sq--more"><text class="sq__more mono">+143</text></view>
    </view>

    <view class="rule"></view>

    <view class="foot">
      <view class="foot__l">
        <view class="foot__pulse"></view>
        <text class="foot__t">桌面端在线 · 12 秒前</text>
      </view>
      <text class="foot__t foot__t--faint">SHA-256 · GPS · 时间戳</text>
    </view>
  </view>
</view>
