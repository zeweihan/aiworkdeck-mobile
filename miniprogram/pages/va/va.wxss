.root {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: var(--s16);
}

/* ---- 抬头 ---------------------------------------------------------- */
.head { padding: var(--s6) var(--gutter) var(--s5); }
.head__label { display: block; margin-bottom: var(--s2); }

.head__name {
  font-size: var(--t-display);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* ---- 状态 ----------------------------------------------------------
 * 数字列宽固定，三行右对齐成一竖列——像账簿。这是"精确"的视觉来源。 */
.stats { padding: var(--s3) var(--gutter); }

.stat {
  display: flex;
  align-items: baseline;
  gap: var(--s3);
  padding: var(--s3) 0;
}

.stat__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
  transform: translateY(-6rpx);
}
.stat__dot--waiting { background: var(--st-waiting); }
.stat__dot--moving  { background: var(--st-moving); }
.stat__dot--arrived { background: var(--st-arrived); }

.stat__num {
  font-size: var(--t-hero);
  font-weight: 300;          /* 细字重的大数字比粗字重更高级 */
  color: var(--fg);
  line-height: 1;
  letter-spacing: -0.04em;
  min-width: 132rpx;
  text-align: right;
}

.stat__body { flex: 1; }

.stat__name {
  font-size: var(--t-body);
  color: var(--fg);
  line-height: 1.3;
}

.stat__where {
  font-size: var(--t-micro);
  color: var(--fg-faint);
  margin-top: 2rpx;
}

/* ---- 主行动 --------------------------------------------------------- */
.act {
  display: flex;
  align-items: center;
  padding: var(--s5) var(--gutter);
  transition: background-color var(--d-fast) var(--e-out);
}
.act--down { background: var(--accent-wash); }

.act__main { flex: 1; }

.act__title {
  font-size: var(--t-title);
  font-weight: 600;
  color: var(--accent);
  letter-spacing: -0.01em;
}

.act__sub {
  font-size: var(--t-micro);
  color: var(--fg-muted);
  margin-top: var(--s1);
}

/* 箭头用 CSS 画，不占图片 */
.act__arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--accent);
  border-right: 2rpx solid var(--accent);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ---- 说明 ----------------------------------------------------------- */
.note { padding: var(--s3) var(--gutter) var(--s6); }

.note__t {
  font-size: var(--t-micro);
  color: var(--fg-faint);
  line-height: 1.7;
}

/* ---- 最近影像 -------------------------------------------------------- */
.sec { padding-bottom: var(--s6); }

.sec__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 var(--gutter) var(--s3);
}

.sec__more { font-size: var(--t-micro); color: var(--fg-muted); }

.strip { white-space: nowrap; padding-left: var(--gutter); }

.thumb {
  position: relative;
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: var(--s2);
  border-radius: 2rpx;       /* 近乎直角。圆角是"App 感"，直角是"文档感"。 */
  overflow: hidden;
}

.thumb__img { width: 100%; height: 100%; }
.thumb__img--doc   { background: #EDEFF2; }
.thumb__img--scene { background: #E7EAE8; }

.thumb__dot {
  position: absolute;
  top: var(--s1);
  left: var(--s1);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.thumb__dot--waiting { background: var(--st-waiting); }
.thumb__dot--moving  { background: var(--st-moving); }
.thumb__dot--arrived { background: var(--st-arrived); }

.thumb__t {
  position: absolute;
  left: var(--s1);
  bottom: var(--s1);
  font-size: var(--t-nano);
  color: var(--fg-muted);
}

/* ---- 页脚 ------------------------------------------------------------ */
.foot {
  display: flex;
  align-items: center;
  gap: var(--s2);
  padding: var(--s4) var(--gutter);
  border-top: 1rpx solid var(--rule);
}

.foot__pulse {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--st-arrived);
}

.foot__t { font-size: var(--t-nano); color: var(--fg-faint); letter-spacing: 0.02em; }
