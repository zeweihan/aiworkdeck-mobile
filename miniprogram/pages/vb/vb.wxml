<!-- 方向 B：影像优先 —— 打开就是你今天拍的东西。
     影像铺满，状态用毛玻璃条压在影像上（这时玻璃才真正成立）。
     快门是悬浮圆钮，不是矩形 CTA。 -->
<view class="root">

  <view class="mosaic" style="padding-top: {{m.navTotalHeight}}px;">
    <view class="cell cell--{{item.kind}} {{index % 5 === 0 ? 'cell--wide' : ''}}"
          wx:for="{{recent}}" wx:key="id"
          style="animation-delay: {{index * 45}}ms">
      <view class="cell__dot cell__dot--{{item.state}}"></view>
      <view class="cell__t mono">{{item.time}}</view>
    </view>
  </view>

  <!-- 顶部玻璃条：压在影像上，模糊有东西可透 -->
  <view class="bar" style="padding-top: {{m.statusBarHeight}}px;">
    <view class="bar__in" style="height: {{m.navContentHeight}}px; padding-right: {{m.capsuleRightInset}}px;">
      <view class="bar__name">{{project.name}}</view>
      <view class="bar__meta">
        <text class="mono bar__n bar__n--waiting">12</text><text class="bar__sep">待传</text>
        <text class="mono bar__n bar__n--moving">3</text><text class="bar__sep">传输中</text>
        <text class="mono bar__n bar__n--arrived">148</text><text class="bar__sep">已归档</text>
      </view>
    </view>
  </view>

  <!-- 底部玻璃座 + 快门 -->
  <view class="dock" style="padding-bottom: calc({{m.bottomInset}}px + 24rpx);">
    <view class="dock__side">
      <view class="dock__pulse"></view>
      <text class="dock__t">桌面端在线</text>
    </view>

    <view class="shutter" bindtap="onCapture" hover-class="shutter--down" hover-stay-time="60">
      <view class="shutter__ring"></view>
      <view class="shutter__core"></view>
    </view>

    <view class="dock__side dock__side--r">
      <text class="dock__t">现场影像</text>
      <text class="dock__t dock__t--faint">08-17</text>
    </view>
  </view>
</view>
