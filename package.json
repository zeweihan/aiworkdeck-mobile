{
  "name": "aiworkdeck-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AI Workdeck 移动端：iOS 原生 + 微信小程序",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.js",
    "test": "node --import ./scripts/node-ts-resolve.mjs --test \"tests/**/*.test.ts\"",
    "contract:gen": "node contract/tools/gen.mjs",
    "contract:check": "node contract/tools/check.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "miniprogram-api-typings": "^4.0.4",
    "miniprogram-automator": "^0.12.1",
    "miniprogram-ci": "^2.1.31",
    "typescript": "^5.6.3"
  }
}
