# 全程走 App Store Connect API Key，不做交互登录、不碰 2FA。
# Key 是 Admin 角色（创建 Distribution 证书必须 Admin，Developer 角色会卡住）。

# cert 动作装 WWDR 中间证书时用的是裸 `curl -f`，没有重试。Apple 的
# certificateauthority CDN 会间歇性回 403 / 半路断流（2026-08-21 发版实测：
# AppleWWDRCAG2.cer 一次 403、一次 curl(56)），而 fastlane 只要 curl 非零就
# 直接 UI.user_error!("Could not install WWDR certificate") 整条 lane 挂掉——
# 哪怕那几张证书早就在钥匙串里。这个开关让它改用 --http1.1 --retry 3
# --retry-all-errors（fastlane 为 issue #20960 留的口子），重试后拿到证书、
# security import 报「已存在」，fastlane 认这条信息并放行。
ENV["FASTLANE_WWDR_USE_HTTP1_AND_RETRIES"] ||= "true"

default_platform(:ios)

def asc_key
  app_store_connect_api_key(
    key_id:     ENV.fetch("ASC_KEY_ID"),
    issuer_id:  ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house:   false
  )
end

platform :ios do
  desc "创建 App Store Connect 应用记录（REST API 不支持 CREATE，只能走这条私有通道）"
  lane :create_app do
    # produce 走的是老的 Tunes 通道，参数表里没有 api_key；
    # app_store_connect_api_key 会把 token 设成全局值，试试它能否被隐式取用。
    asc_key
    produce(
      app_identifier: "com.aiworkdeck.mobile",
      app_name:       ENV["APP_NAME"] || "AI WorkDeck",
      language:       "English",
      sku:            "workdeck-mobile-2026",
      team_id:        ENV.fetch("APPLE_TEAM_ID"),
      skip_devcenter: true      # Bundle ID 已用 REST API 建好
    )
  end
end

# ---------------- Live Activity 扩展的签名（dev-board#404） ----------------
# 扩展是独立 bundle（com.aiworkdeck.mobile.LiveActivity），要自己的 App ID 与描述文件。
# 国际版：sigh 多签一份。sigh 对没注册的 bundle id 直接 user_error，所以先把
# App ID 注册上（幂等：已存在就跳过）。这里不用 produce：2.235.0 的 produce 没有
# api_key 参数，走的是 Apple ID 交互登录，CI 上跑不了；app_store_connect_api_key
# 已把 token 设成 Spaceship::ConnectAPI 全局值，直接打 bundleIds 接口即可。
# 大陆版：描述文件与主 App 一样由人在 ASC 手建，见 ci_appstore 里 CN_LA_PROFILE_PATH 的说明。
def ensure_bundle_id(identifier, name)
  return if Spaceship::ConnectAPI::BundleId.find(identifier)
  UI.message("注册 App ID #{identifier}")
  Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
end

# 国际版主 App + 扩展各签一份 App Store 描述文件，返回 export_options 用的
# provisioningProfiles 映射。lane_context[SIGH_NAME] 会被第二次 sigh 覆盖，
# 所以每次 sigh 完立刻取值，不要在最后才读。
def sigh_intl(key)
  sigh(api_key: key, app_identifier: "com.aiworkdeck.mobile",
       platform: "ios", output_path: "fastlane/profiles")
  app_profile = lane_context[SharedValues::SIGH_NAME]
  ensure_bundle_id("com.aiworkdeck.mobile.LiveActivity", "AI WorkDeck Live Activity")
  sigh(api_key: key, app_identifier: "com.aiworkdeck.mobile.LiveActivity",
       platform: "ios", output_path: "fastlane/profiles")
  {
    "com.aiworkdeck.mobile" => app_profile,
    "com.aiworkdeck.mobile.LiveActivity" => lane_context[SharedValues::SIGH_NAME]
  }
end

# 大陆版两份描述文件都是手建的，名字固定。
def cn_profiles
  {
    "com.aiworkdeck.mobile.cn" => "AI WorkDeck CN AppStore",
    "com.aiworkdeck.mobile.cn.LiveActivity" => "AI WorkDeck CN LiveActivity AppStore"
  }
end

platform :ios do
  desc "打包并上传 TestFlight"
  lane :beta do
    key = asc_key

    # 用专属 keychain，不用 login.keychain——避免 codesign 撞 ACL 弹窗 /
    # errSecInternalComponent。这台机上 fastlane_build 已经有 Distribution 私钥。
    kc_path = File.expand_path("~/Library/Keychains/fastlane_build-db")
    unless File.exist?(kc_path)
      create_keychain(name: "fastlane_build", password: "fastlane_build",
                      unlock: true, timeout: 3600, lock_when_sleeps: false)
    end
    unlock_keychain(path: "fastlane_build", password: "fastlane_build", set_default: false)

    # 构建号取 TestFlight 上的最新值 +1：ASC 对重复 build 号会报
    # ENTITY_ERROR.ATTRIBUTE.INVALID.DUPLICATE，Claws 踩过。
    build = latest_testflight_build_number(
      api_key: key, app_identifier: "com.aiworkdeck.mobile", initial_build_number: 0
    ) + 1
    UI.message("本次 build 号 #{build}")
    # 不用 increment_build_number 改 xcodeproj——工程是 XcodeGen 从 project.yml 生成的，
    # 改了下次 generate 就冲掉，build 号永远停在 1，ASC 会按重复号拒收（Claws 踩过）。
    # 走 xcargs 在构建期注入。
    sh("cd .. && xcodegen generate --spec ios/project.yml --project ios") rescue nil

    cert(api_key: key, development: false, keychain_path: kc_path,
         keychain_password: "fastlane_build", output_path: "fastlane/certs")
    profiles = sigh_intl(key)

    build_app(
      project: "ios/Workdeck.xcodeproj",
      scheme: "Workdeck",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: profiles
      }
    )

    upload_to_testflight(
      api_key: key,
      # 不等处理完是为了省 5-15 分钟；代价是 fastlane 传完即退、**不做分组**。
      # 所以下面必须补一步把构建挂进内部测试组，否则包在 ASC 里是 VALID 的，
      # 测试组里却一个都没有，手机上永远只看得到最早那版（2026-08-18 踩过，
      # 连发五版都没送到测试员手上）。
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "现场拍摄与本地归档：拍照/录像、SHA-256、时间与地点。上传链路未接。"
    )

    # 传完把构建挂进内部测试组（见上面的注释）。放在 lane 内、upload 之后。
    # 用仓库 venv 的 python：裸 python3 是 brew 管的，PEP 668 拒装 PyJWT，
    # 且 brew 升级会清空 site-packages——2026-08-20 就是这么断的（build 7 传上去进不了组）。
    # venv 不在了就现场重建，别让进组这步再静默依赖机器状态。
    sh("cd .. && test -x .venv/bin/python || " \
       "(python3 -m venv .venv && .venv/bin/pip install --quiet pyjwt cryptography)")
    sh("cd .. && ASC_APP_ID=6802233845 ASC_KEY_ID=#{ENV.fetch('ASC_KEY_ID')} " \
       "ASC_ISSUER_ID=#{ENV.fetch('ASC_ISSUER_ID')} ASC_KEY_PATH=#{ENV.fetch('ASC_KEY_PATH')} " \
       ".venv/bin/python scripts/attach-build-to-group.py")
  end
end

# ---------------- 大陆版（北京京微资易，Team 8WKHZVR2W8） ----------------
# 与国际版 beta 的三点不同，改这条 lane 前先读：
# 1) 凭据是另一套 ASC Key（jwzy 团队，Admin）。默认值就是现役那套，
#    env（ASC_CN_*）只用于覆盖，平时一个变量都不用 export。
# 2) 不跑 cert/sigh：Distribution 证书 579SG95VN2 的私钥是本机 openssl 生成的，
#    fastlane 拿不到；2026-08-20 已导入 fastlane_build keychain，profile
#    （AI WorkDeck CN AppStore / VCM2ZDV8KD）也已装进本机。机器重装后照
#    5-Tech/EXTERNAL_SERVICES.md §6.7 把 p12 与 .mobileprovision 装回来即可。
#    另：这张证书的公钥/SHA-1 已绑 App 备案，撤销重建=同步做备案变更。
# 3) 不需要 attach-build-to-group.py：CN 的内部测试组（942673b0…）建的时候
#    就是 hasAccessToAllBuilds，构建处理完自动对组可见。

def asc_key_cn
  %w[ASC_CN_KEY_ID ASC_CN_ISSUER_ID ASC_CN_KEY_PATH].each do |k|
    UI.user_error!("missing #{k} (fastlane/.env, 见 5-Tech/EXTERNAL_SERVICES.md §6.7)") if ENV[k].to_s.empty?
  end
  app_store_connect_api_key(
    key_id:     ENV["ASC_CN_KEY_ID"],
    issuer_id:  ENV["ASC_CN_ISSUER_ID"],
    key_filepath: File.expand_path(ENV["ASC_CN_KEY_PATH"]),
    in_house: false
  )
end

platform :ios do
  desc "大陆版打包并上传 TestFlight（com.aiworkdeck.mobile.cn，ASC App 6803309103）"
  lane :beta_cn do
    key = asc_key_cn

    kc_path = File.expand_path("~/Library/Keychains/fastlane_build-db")
    UI.user_error!("fastlane_build keychain 不存在，先照 EXTERNAL_SERVICES.md §6.7 恢复") unless File.exist?(kc_path)
    unlock_keychain(path: "fastlane_build", password: "fastlane_build", set_default: false)

    build = latest_testflight_build_number(
      api_key: key, app_identifier: "com.aiworkdeck.mobile.cn", initial_build_number: 0
    ) + 1
    UI.message("大陆版本次 build 号 #{build}")
    sh("cd .. && xcodegen generate --spec ios/project.yml --project ios") rescue nil

    build_app(
      project: "ios/Workdeck.xcodeproj",
      scheme: "WorkdeckCN",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "WorkdeckCN.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      # gym 默认会扫工程里所有 target 的签名设置并入 exportOptions——会把国际版
      # 「com.aiworkdeck.mobile → …AppStore」的映射也塞进来，xcodebuild 拿京微资易
      # 团队找 HK 的 profile 直接 EXPORT FAILED。关掉探测，只认下面显式给的映射。
      skip_profile_detection: true,
      export_options: {
        signingStyle: "manual",
        teamID: "8WKHZVR2W8",
        provisioningProfiles: cn_profiles
      }
    )

    upload_to_testflight(
      api_key: key,
      app_identifier: "com.aiworkdeck.mobile.cn",
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "现场拍摄与本地归档：拍照/录像、SHA-256、时间与地点。"
    )
  end
end

# ---------------- 正式上架（App Store，不是 TestFlight） ----------------
# 与 beta / beta_cn 的关系：这两条只多做一件事——把构建号与 MARKETING_VERSION
# 对齐到正式版。**上传通道刻意与 beta 相同**：ASC 里 TestFlight 与 App Store
# 共用同一批构建，选哪个发布是版本记录那边的事，不取决于用哪条通道传上去。
#
# 一度改用 upload_to_app_store（deliver）一把梭，2.235.0 上它在 spaceship
# 解析回包时抛 "No data"（上游已知问题），而升 fastlane 会动到现役的
# beta / beta_cn。文案、分级、定价、区域、挂构建、提审因此全部收在
# scripts/asc-listing.py，那边是直接打 REST API，不受 fastlane 版本影响。
#
# **lane 不提审**。提审是对外动作、撤回要重新排队，那一下由人显式去做。

# 版本号只有一个来源：ios/project.yml 的 MARKETING_VERSION。
# 在这儿再写一遍死值，早晚会出现「构建是 1.0.1、ASC 上传到 1.0.0」。
def marketing_version
  spec = File.read(File.expand_path("../ios/project.yml", __dir__))
  m = spec[/^\s*MARKETING_VERSION:\s*"([^"]+)"/, 1]
  UI.user_error!("ios/project.yml 里读不到 MARKETING_VERSION") if m.nil?
  m
end

platform :ios do
  desc "国际版打正式版包并上传（App Store 侧用 scripts/asc-listing.py 收尾）"
  lane :release do
    key = asc_key

    kc_path = File.expand_path("~/Library/Keychains/fastlane_build-db")
    UI.user_error!("fastlane_build keychain 不存在，先照 EXTERNAL_SERVICES.md §6.5 恢复") unless File.exist?(kc_path)
    unlock_keychain(path: "fastlane_build", password: "fastlane_build", set_default: false)

    # 构建号仍然跟 TestFlight 上的最大值走：正式版与测试版在 ASC 里共用
    # 同一个构建号空间，各算各的一定撞 DUPLICATE。
    build = latest_testflight_build_number(
      api_key: key, app_identifier: "com.aiworkdeck.mobile", initial_build_number: 0
    ) + 1
    UI.message("国际版 #{marketing_version} (#{build})")
    sh("cd .. && xcodegen generate --spec ios/project.yml --project ios") rescue nil

    cert(api_key: key, development: false, keychain_path: kc_path,
         keychain_password: "fastlane_build", output_path: "fastlane/certs")
    profiles = sigh_intl(key)

    build_app(
      project: "ios/Workdeck.xcodeproj",
      scheme: "Workdeck",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: profiles
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "正式版候选。"
    )

    UI.success("国际版 #{marketing_version} (#{build}) 已上传。接着跑：\n" \
               "  .venv/bin/python scripts/asc-listing.py attach intl #{build}\n" \
               "  .venv/bin/python scripts/asc-listing.py status intl")
  end
end

