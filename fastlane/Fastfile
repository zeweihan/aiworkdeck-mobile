    upload_to_testflight(
      api_key: key,
      app_identifier: "com.aiworkdeck.mobile.cn",
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "正式版候选。"
    )

    # ICP 备案号（京ICP备2024096997号-13A）ASC 没开放 API，只能在网页
    # 「App 信息 → 中国大陆 ICP 备案号」填。没填就提审会被直接挡下。
    UI.important("提审前确认 ASC 网页已填 ICP 备案号，且 App 名称与备案表逐字一致")
    UI.success("大陆版 #{marketing_version} (#{build}) 已上传。接着跑：\n" \
               "  .venv/bin/python scripts/asc-listing.py attach cn #{build}\n" \
               "  .venv/bin/python scripts/asc-listing.py status cn")
  end
end

# ---------------- CI 打包（GitHub Actions，发行版 macOS runner）----------------
# 为什么存在：打包机跑 macOS beta 时，包里的 BuildMachineOSBuild 记录的是 beta
# 系统号，提审一律被 ITMS-90111 打回——Xcode 与 SDK 都是正式版也救不回来
# （2026-09-01 国际版 build 15/17、大陆版 build 5 三连实测；Apple 邮件文案只提
# Xcode/SDK，不提打包机系统，别被它带偏）。正式包因此挪到 GitHub 的发行版
# macOS runner 上打。签名材料由工作流从 secrets 落到 $RUNNER_TEMP（先例：
# 桌面仓的 CSC_LINK 同样是 p12 进 secrets，见 EXTERNAL_SERVICES.md §6.4）。
#
# 环境契约（.github/workflows/appstore-build.yml 负责准备）：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH          国际版 ASC API Key
#   ASC_CN_KEY_ID / ASC_CN_ISSUER_ID / ASC_CN_KEY_PATH 大陆版 ASC API Key
#   APPLE_TEAM_ID                                       X9B97KVA84
#   DIST_P12_PATH / DIST_P12_PASSWORD                   一份 p12，含两个团队的
#                                                       Distribution 身份（本机
#                                                       fastlane_build keychain 导出）
#   CN_PROFILE_PATH                                     AI WorkDeck CN AppStore 描述文件
#   CN_LA_PROFILE_PATH                                  同上，Live Activity 扩展的（可缺，见下）
#   FLAVOR                                              intl / cn / both（默认 both）
platform :ios do
  desc "CI：发行版 macOS 上打正式包并上传（intl + cn）"
  lane :ci_appstore do
    flavor = (ENV["FLAVOR"] || "both").strip
    setup_ci   # 建临时 keychain 并设为默认（fastlane_tmp_keychain，空口令）

    # 取构建号与进组都要走 ASC API 的 python 脚本，venv 先备好
    sh("cd .. && test -x .venv/bin/python || " \
       "(python3 -m venv .venv && .venv/bin/pip install --quiet pyjwt cryptography)")

    import_certificate(
      certificate_path: ENV.fetch("DIST_P12_PATH"),
      certificate_password: ENV.fetch("DIST_P12_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # CN 的描述文件不走 sigh（私钥不是 fastlane 生成的），直接装进扫描目录。
    # Xcode 16 起换了位置，两处都放，不赌 runner 上的版本。
    ["~/Library/MobileDevice/Provisioning Profiles",
     "~/Library/Developer/Xcode/UserData/Provisioning Profiles"].each do |d|
      dir = File.expand_path(d)
      FileUtils.mkdir_p(dir)
      FileUtils.cp(ENV.fetch("CN_PROFILE_PATH"),
                   File.join(dir, "aiworkdeck-cn-appstore.mobileprovision"))
      # Live Activity 扩展的大陆版描述文件（dev-board#404）：由用户在 ASC 建好
      # （bundle id com.aiworkdeck.mobile.cn.LiveActivity，名 AI WorkDeck CN
      # LiveActivity AppStore）后加 secret CN_LA_PROFILE_B64，工作流才会导出这个
      # 变量。建好之前 CN 归档会在 exportArchive 因扩展没有描述文件而失败——
      # 这是预期，不是 lane 的 bug；届时先用 FLAVOR=intl 单打国际版。
      la = ENV["CN_LA_PROFILE_PATH"]
      if la && File.exist?(la)
        FileUtils.cp(la, File.join(dir, "aiworkdeck-cn-liveactivity-appstore.mobileprovision"))
      end
    end

    sh("cd .. && xcodegen generate --spec ios/project.yml --project ios")

    if %w[intl both].include?(flavor)
      key = asc_key
      # 不用 latest_testflight_build_number：它只看最新预发布版本下的构建，会漏号
      # （2026-09-02 报 19 而 ASC 已有 20，上传撞 409 buildUpload INVALID_STATE）。
      build = sh("cd .. && .venv/bin/python scripts/asc-next-build.py intl").strip.to_i
      UI.message("CI 国际版 #{marketing_version} (#{build})")
      profiles = sigh_intl(key)
      build_app(
        project: "ios/Workdeck.xcodeproj", scheme: "Workdeck", configuration: "Release",
        export_method: "app-store", output_directory: "ios/build",
        xcargs: "CURRENT_PROJECT_VERSION=#{build}",
        export_options: {
          signingStyle: "manual", teamID: ENV.fetch("APPLE_TEAM_ID"),
          provisioningProfiles: profiles
        })
      upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true,
                           changelog: ENV["CHANGELOG"] || "CI 构建（发行版 macOS）。")

      # 必须补这一步。skip_waiting_for_build_processing 省掉了等处理的 5-15 分钟，
      # 代价是 fastlane 传完即退、**不做分组**；而国际版的内部组
      # hasAccessToAllBuilds=false，构建不会自己进组——包在 ASC 里是 VALID 的，
      # TestFlight 里却一个都看不到（2026-08-18 与 09-02 各踩一次）。
      sh("cd .. && ASC_APP_ID=6802233845 ASC_KEY_ID=#{ENV.fetch('ASC_KEY_ID')} " \
         "ASC_ISSUER_ID=#{ENV.fetch('ASC_ISSUER_ID')} ASC_KEY_PATH=#{ENV.fetch('ASC_KEY_PATH')} " \
         ".venv/bin/python scripts/attach-build-to-group.py")
    end

    if %w[cn both].include?(flavor)
      key = asc_key_cn
      build = sh("cd .. && .venv/bin/python scripts/asc-next-build.py cn").strip.to_i
      UI.message("CI 大陆版 #{marketing_version} (#{build})")
      build_app(
        project: "ios/Workdeck.xcodeproj", scheme: "WorkdeckCN", configuration: "Release",
        export_method: "app-store", output_directory: "ios/build", output_name: "WorkdeckCN.ipa",
