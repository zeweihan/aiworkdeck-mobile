      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "WorkdeckCN.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      # 理由同 beta_cn：不关探测会把国际版的 profile 映射也塞进 exportOptions。
      skip_profile_detection: true,
      export_options: {
        signingStyle: "manual",
        teamID: "8WKHZVR2W8",
