{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["cases"], "additionalProperties": false,
  "properties": { "cases": { "type": "array", "minItems": 1, "items": {
    "type": "object", "required": ["state", "attempts", "expect"], "additionalProperties": false,
    "properties": { "state": { "$ref": "#/$defs/state" }, "attempts": { "type": "integer", "minimum": 0 }, "expect": { "$ref": "#/$defs/state" } }
  } } },
  "$defs": { "state": { "enum": ["waiting", "uploading", "uploaded", "arrived", "failed"] } }
}
