{
  "balance": [
    { "name": "付费档：plan 是计费档位不是套餐名，各端不得直接渲染；display 无千分位（带千分位会是 ¥1,234.56）", "json": { "balanceCents": 123456, "currency": "CNY", "plan": "paid" },
      "expect": { "balanceCents": 123456, "currency": "CNY", "plan": "paid" },
      "display": "¥1234.56" },
    { "name": "免费档余额 0：plan=free，不是「无套餐」", "json": { "balanceCents": 0, "currency": "CNY", "plan": "free" },
      "expect": { "balanceCents": 0, "currency": "CNY", "plan": "free" },
      "display": "¥0.00" },
    { "name": "国际站币种为 USD", "json": { "balanceCents": 990, "currency": "USD", "plan": "free" },
      "expect": { "balanceCents": 990, "currency": "USD", "plan": "free" },
      "display": "$9.90" },
    { "name": "上游没给 plan 这个字段：解成 null（getPlan() 自己只回 paid/free，不会是 null）", "json": { "balanceCents": 5000, "currency": "CNY", "plan": null },
      "expect": { "balanceCents": 5000, "currency": "CNY", "plan": null },
      "display": "¥50.00" }
  ],
  "recharge": [
    { "name": "qrcode：codeUrl 与 qrCode 都在，redirectUrl 不出现",
      "json": { "present": "qrcode", "outTradeNo": "awd20260904000123", "amountCents": 5000,
                "codeUrl": "weixin://wxpay/bizpayurl?pr=abc123", "qrCode": "data:image/png;base64,iVBORw0KGgo=" },
      "expect": { "present": "qrcode", "outTradeNo": "awd20260904000123", "amountCents": 5000,
                  "codeUrl": "weixin://wxpay/bizpayurl?pr=abc123", "qrCode": "data:image/png;base64,iVBORw0KGgo=", "redirectUrl": null } },
    { "name": "qrcode：只给 codeUrl，qrCode 键缺席要解成 null",
      "json": { "present": "qrcode", "outTradeNo": "awd20260904000124", "amountCents": 10000,
                "codeUrl": "weixin://wxpay/bizpayurl?pr=def456" },
      "expect": { "present": "qrcode", "outTradeNo": "awd20260904000124", "amountCents": 10000,
                  "codeUrl": "weixin://wxpay/bizpayurl?pr=def456", "qrCode": null, "redirectUrl": null } },
    { "name": "redirect：codeUrl/qrCode 键缺席要解成 null",
      "json": { "present": "redirect", "outTradeNo": "awd20260904000125", "amountCents": 30000,
                "redirectUrl": "https://aiworkdeck.com/pay/checkout/sess_123" },
      "expect": { "present": "redirect", "outTradeNo": "awd20260904000125", "amountCents": 30000,
                  "codeUrl": null, "qrCode": null, "redirectUrl": "https://aiworkdeck.com/pay/checkout/sess_123" } }
  ],
  "status": [
    { "name": "待支付", "json": { "status": "pending", "paid": false, "amountCents": 5000 },
      "expect": { "status": "pending", "paid": false, "amountCents": 5000 } },
    { "name": "已到账", "json": { "status": "paid", "paid": true, "amountCents": 5000 },
      "expect": { "status": "paid", "paid": true, "amountCents": 5000 } },
    { "name": "已关单", "json": { "status": "closed", "paid": false, "amountCents": 10000 },
      "expect": { "status": "closed", "paid": false, "amountCents": 10000 } },
    { "name": "已过期", "json": { "status": "expired", "paid": false, "amountCents": 30000 },
      "expect": { "status": "expired", "paid": false, "amountCents": 30000 } }
  ],
  "envelope": [
    { "name": "未登录：会话失效，四端应回登录页（code 4010 不带 kind）",
      "json": { "code": 4010, "message": "请先登录" },
      "expect": { "code": 4010, "message": "请先登录", "kind": null, "outTradeNo": null } },
    { "name": "code 1 但没有 kind：非 billing 专有的失败（如缺 idempotencyKey）走通用 handler，各端按「读不到」降级，不得当成没有账户",
      "json": { "code": 1, "message": "缺少或非法的 idempotencyKey，请升级客户端后重试" },
      "expect": { "code": 1, "message": "缺少或非法的 idempotencyKey，请升级客户端后重试", "kind": null, "outTradeNo": null } },
    { "name": "DISABLED：本服务器没配 mobile.billing.*，服务端不发上游请求 → 收起充值入口",
      "json": { "code": 1, "kind": "DISABLED", "message": "此服务器未开通统一账户充值" },
      "expect": { "code": 1, "kind": "DISABLED", "message": "此服务器未开通统一账户充值", "outTradeNo": null } },
    { "name": "UNAVAILABLE：上游不可用（网络/5xx/官网空体 404 即密钥或 env 配错）→ 稍后重试，绝不能显示成没有账户或余额 0",
      "json": { "code": 1, "kind": "UNAVAILABLE", "message": "账户服务暂不可用，请稍后再试" },
      "expect": { "code": 1, "kind": "UNAVAILABLE", "message": "账户服务暂不可用，请稍后再试", "outTradeNo": null } },
    { "name": "NOT_CONNECTED：这个登录账号没有已验证的手机号或邮箱 → 不渲染余额那一行",
      "json": { "code": 1, "kind": "NOT_CONNECTED", "message": "该账号还没有已验证的手机号或邮箱，无法关联统一账户" },
      "expect": { "code": 1, "kind": "NOT_CONNECTED", "message": "该账号还没有已验证的手机号或邮箱，无法关联统一账户", "outTradeNo": null } },
    { "name": "NOT_CONNECTED：官网按该身份查无账户（读余额一律 create=false，服务端不替用户建号）",
      "json": { "code": 1, "kind": "NOT_CONNECTED", "message": "该账号还没有关联的统一账户" },
      "expect": { "code": 1, "kind": "NOT_CONNECTED", "message": "该账号还没有关联的统一账户", "outTradeNo": null } },
    { "name": "NOT_FOUND：官网明确回查无此物（accountId 已注销 / 单号不属于该账户）",
      "json": { "code": 1, "kind": "NOT_FOUND", "message": "未找到对应的统一账户" },
      "expect": { "code": 1, "kind": "NOT_FOUND", "message": "未找到对应的统一账户", "outTradeNo": null } },
    { "name": "REJECTED：该统一账户已绑给别的登录账号，绝不改绑",
      "json": { "code": 1, "kind": "REJECTED", "message": "该统一账户已与另一个登录账号关联，请用原账号登录后充值" },
      "expect": { "code": 1, "kind": "REJECTED", "message": "该统一账户已与另一个登录账号关联，请用原账号登录后充值", "outTradeNo": null } },
    { "name": "REJECTED：官网明确拒绝的业务错误",
      "json": { "code": 1, "kind": "REJECTED", "message": "充值请求被拒绝，请稍后重试或联系客服" },
      "expect": { "code": 1, "kind": "REJECTED", "message": "充值请求被拒绝，请稍后重试或联系客服", "outTradeNo": null } },
    { "name": "REVIEW_ACCOUNT：App 审核演示账号，余额与充值入口一律关掉",
      "json": { "code": 1, "kind": "REVIEW_ACCOUNT", "message": "审核演示账号不支持余额与充值" },
      "expect": { "code": 1, "kind": "REVIEW_ACCOUNT", "message": "审核演示账号不支持余额与充值", "outTradeNo": null } },
    { "name": "ALREADY_PAID：带 outTradeNo，App 被杀没存下单号时靠它转去查单，别重新下单",
      "json": { "code": 1, "kind": "ALREADY_PAID", "outTradeNo": "RECHARGE20260904000987", "message": "这笔充值已经支付成功，请查看订单状态" },
      "expect": { "code": 1, "kind": "ALREADY_PAID", "outTradeNo": "RECHARGE20260904000987", "message": "这笔充值已经支付成功，请查看订单状态" } },
    { "name": "IDEMPOTENCY_CONFLICT：同一把幂等键换了金额/类型，同样带 outTradeNo",
      "json": { "code": 1, "kind": "IDEMPOTENCY_CONFLICT", "outTradeNo": "RECHARGE20260904000988", "message": "该充值请求与已有订单不一致，请重新发起" },
      "expect": { "code": 1, "kind": "IDEMPOTENCY_CONFLICT", "outTradeNo": "RECHARGE20260904000988", "message": "该充值请求与已有订单不一致，请重新发起" } }
  ]
}
